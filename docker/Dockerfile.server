FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY pom.xml .
COPY hes-common/pom.xml hes-common/pom.xml
COPY hes-server/pom.xml hes-server/pom.xml
COPY hes-agent-simulator/pom.xml hes-agent-simulator/pom.xml
COPY hes-common hes-common
COPY hes-server hes-server
COPY hes-agent-simulator hes-agent-simulator
RUN mvn -pl hes-server -am -DskipTests package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /workspace/hes-server/target/hes-server-*.jar /app/app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
